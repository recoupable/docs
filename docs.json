{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Recoup",
  "colors": {
    "primary": "#345A5D",
    "light": "#4A7A7D",
    "dark": "#1E3A3D"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "cli",
              "mcp",
              "authentication",
