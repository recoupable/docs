            "openapi": {
              "source": "api-reference/openapi/accounts.json",
              "directory": "api-reference/accounts"
            }
          },
          {
            "group": "Admins",
            "openapi": {
              "source": "api-reference/openapi/admins.json",
              "directory": "api-reference/admins"
            }
          },
          {
            "group": "Artists",
            "openapi": {
              "source": "api-reference/openapi/artists.json",
              "directory": "api-reference/artists"
            }
          },
          {
            "group": "Social",
            "openapi": {
              "source": "api-reference/openapi/social.json",
              "directory": "api-reference/social"
            }
          },
          {
            "group": "Content",
            "openapi": {
              "source": "api-reference/openapi/content.json",
              "directory": "api-reference/content"
            }
          },
          {
            "group": "Sandboxes",
            "openapi": {
              "source": "api-reference/openapi/sandboxes.json",
              "directory": "api-reference/sandboxes"
