    ],
    "global": {
      "anchors": [
        {
          "anchor": "Recoup App",
          "href": "https://chat.recoupable.com",
          "icon": "rocket"
        },
        {
          "anchor": "Website",
          "href": "https://recoupable.com",
          "icon": "globe"
        },
        {
          "anchor": "Blog",
          "href": "https://research.recoupable.com/",
          "icon": "newspaper"
        }
      ]
    }
